# ======================================================================================================
#  VenteExpress — variables d'environnement (EXEMPLE : aucune vraie valeur ici)
#  À renseigner dans Netlify : Site configuration > Environment variables. Ne mettez JAMAIS ces valeurs dans le code ni dans GitHub.
#  Les fonctions WhatsApp restent « éteintes » tant que les variables WHATSAPP_* ne sont pas toutes renseignées : l'application marche normalement sans.
# ======================================================================================================

# --- Supabase (Project settings > API) -------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=...                      # clé « anon public »
SUPABASE_SERVICE_ROLE_KEY=...              # clé « service_role » : SECRÈTE, uniquement ici (jamais dans l'appli ni sur GitHub)

# --- WhatsApp Cloud API (Meta) ----------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=...                  # jeton permanent d'un « utilisateur système » (Business Settings > System users) avec whatsapp_business_messaging et whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=...               # WhatsApp Manager / API Setup : « Phone number ID » (pas le numéro lui-même)
WHATSAPP_BUSINESS_ACCOUNT_ID=...           # « WhatsApp Business Account ID » (sert à créer/lire les modèles de messages)
WHATSAPP_VERIFY_TOKEN=...                  # un mot de passe que VOUS inventez (long, aléatoire) ; le même sera collé chez Meta dans « Verify token »
META_APP_SECRET=...                        # App dashboard > App settings > Basic > « App secret » : sert à vérifier la signature des notifications de Meta

# --- Facultatif ------------------------------------------------------------------------------------
# WHATSAPP_API_VERSION=v23.0               # version de l'API Graph de Meta (par défaut v23.0)
