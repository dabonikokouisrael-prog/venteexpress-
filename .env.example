# ======================================================================================================
#  VenteExpress — variables d'environnement (EXEMPLE : aucune vraie valeur ici)
#  À renseigner dans Netlify : Site configuration > Environment variables. Ne mettez JAMAIS ces valeurs dans le code ni dans GitHub.
#  Après avoir ajouté ou changé une variable, Netlify demande un NOUVEAU DÉPLOIEMENT pour qu'elle soit prise en compte.
#  Les fonctions WhatsApp restent « éteintes » tant que les variables WHATSAPP_* ne sont pas toutes renseignées : l'application marche normalement sans.
# ======================================================================================================

# --- Supabase : nouvelles clés (Project settings > API Keys) ----------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co   # « Project URL » : l'adresse du projet, sans /rest/v1
SUPABASE_ANON_KEY=sb_publishable_…              # clé « Publishable » : PUBLIQUE par conception (remplace l'ancienne clé « anon »). NE PAS cocher « Contains secret values ».
SUPABASE_SECRET_KEY=sb_secret_…                 # clé « Secret » : SECRÈTE, uniquement ici, côté serveur (remplace l'ancienne clé « service_role »). Cocher « Contains secret values ».
# L'ancienne variable SUPABASE_SERVICE_ROLE_KEY n'est plus utilisée : supprimez-la une fois la nouvelle en place (elle n'est lue que si SUPABASE_SECRET_KEY est absente).

# --- WhatsApp Cloud API (Meta) ----------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=...                  # jeton permanent d'un « utilisateur système » (Business Settings > System users) avec whatsapp_business_messaging et whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=...               # WhatsApp Manager / API Setup : « Phone number ID » (pas le numéro lui-même)
WHATSAPP_BUSINESS_ACCOUNT_ID=...           # « WhatsApp Business Account ID » (sert à créer/lire les modèles de messages)
WHATSAPP_VERIFY_TOKEN=...                  # un mot de passe que VOUS inventez (long, aléatoire) ; le même sera collé chez Meta dans « Verify token »
META_APP_SECRET=...                        # App dashboard > App settings > Basic > « App secret » : sert à vérifier la signature des notifications de Meta

# --- Messages du catalogue : alerte e-mail au vendeur (version 3.7.3) -------------------------------
# Choisis UN fournisseur. Sans l'un des deux, aucun e-mail n'est envoyé ; les messages sont quand même enregistrés.
# RESEND_API_KEY=...                       # clé Resend (resend.com) : elle reste ici, jamais dans le code
# NOTIFY_FROM=...                          # adresse d'expédition vérifiée chez Resend, par exemple « VenteExpress <alertes@votre-domaine.com> »
# SMTP_HOST=...                            # OU un serveur SMTP classique (nom du serveur, sans https://)
# SMTP_PORT=587                            # 587 par défaut ; 465 = connexion chiffrée directe
# SMTP_USER=...                            # identifiant SMTP (facultatif si le serveur n'en demande pas)
# SMTP_PASS=...                            # mot de passe SMTP
# SMTP_FROM=...                            # adresse d'expédition, par exemple « VenteExpress <alertes@votre-domaine.com> »

# --- Connexion WhatsApp par Meta (version 3.7.3) : PRÉPARÉE, DÉSACTIVÉE -----------------------------
# Tant que META_CONNECT_ENABLED n'est pas « true », la fonction ne répond pas et le bouton n'apparaît pas.
# META_CONNECT_ENABLED=...                 # mettre « true » seulement après les essais décrits dans docs/08
# META_APP_ID=...                          # App dashboard > App settings > Basic > « App ID » (public)
# META_CONFIG_ID=...                       # Facebook Login for Business > Configurations > « Configuration ID »
# META_FEATURE_TYPE=...                    # facultatif : valeur donnée par Meta pour la cohabitation avec l'appli WhatsApp Business
# WA_TOKEN_KEY=...                         # clé de chiffrement du jeton : 32 octets en base64 (commande : openssl rand -base64 32)

# --- Facultatif ------------------------------------------------------------------------------------
# WHATSAPP_API_VERSION=v23.0               # version de l'API Graph de Meta (par défaut v23.0)
# AI_MONTHLY_SMALL=60                      # annonces IA par mois, formule Solo (par défaut 60)
# AI_MONTHLY_LARGE=300                     # annonces IA par mois, formule Équipe (par défaut 300)
# AI_DAILY_LIMIT=30                        # annonces IA par appareil et par jour, pour les comptes SANS compte en ligne (par défaut 30)
# AI_GLOBAL_DAILY_LIMIT=300                # garde-fou qui protège la clé Claude : s'applique TOUJOURS (par défaut 300)
